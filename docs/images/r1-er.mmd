  USER {
    key id PK
    string email UK
    string display_name
    string avatar_preset
    enum visitor_type
    string province
    datetime onboarded_at
  }
  EVENT {
    key id PK
    string slug UK
    string title
    enum status
    int capacity
    datetime starts_at
    datetime ends_at
    string allowed_domain
    string hall_preset
  }
  EVENT_MEMBER {
    key event_id PK,FK
    key user_id PK,FK
    enum_list roles
  }
  INVITE {
    key id PK
    string email
    enum_list roles
    string token_hash UK
    enum status
    datetime expires_at
  }
  ATTENDEE {
    key event_id PK,FK
    key user_id PK,FK
    string display_name
    enum visitor_type
    string province
    datetime joined_at
  }
  HALL {
    key id PK
    json map_json
  }
  BOOTH_SLOT {
    key id PK
    string block
    int fill_order
    int x
    int y
    string label
  }
  CATEGORY {
    key id PK
    string name
    string color
  }
  PROJECT {
    key id PK
    string title
    string summary
    string_list tags
    string video_url
    json links
  }
  PROJECT_MEMBER {
    key project_id PK,FK
    key user_id PK,FK
  }
  PROJECT_FILE {
    key id PK
    enum kind
    string object_key
    string mime
    int size_bytes
    int page_count
  }
