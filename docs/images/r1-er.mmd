erDiagram
  USER ||--o{ EVENT_MEMBER : "has role in"
  EVENT ||--o{ EVENT_MEMBER : "has"
  EVENT ||--o{ INVITE : "sends"
  EVENT ||--o{ ATTENDEE : "joined by"
  USER ||--o{ ATTENDEE : "joins as"
  EVENT ||--|| HALL : "has"
  HALL ||--|{ BOOTH_SLOT : "contains"
  EVENT ||--o{ CATEGORY : "groups by"
  EVENT ||--o{ PROJECT : "shows"
  CATEGORY |o--o{ PROJECT : "classifies"
  BOOTH_SLOT |o--o| PROJECT : "placed at"
  PROJECT ||--|{ PROJECT_MEMBER : "presented by"
