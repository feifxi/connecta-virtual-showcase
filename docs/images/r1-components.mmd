flowchart TB
  subgraph PAGES[app/ · Next.js routes]
    direction LR
    P1[event page] ~~~ P2[hall page] ~~~ P3[my booth] ~~~ P4[admin]
  end
  subgraph FEAT[features/ · screen parts]
    direction LR
    F1[HallView] --> F4[BoothList]
    F1 --> F5[HallToolbar]
    F1 --> F2[BoothPanel] --> F3[PosterViewer]
    F6[ProjectForm]
  end
  subgraph GAME[game/ · Phaser 4]
    direction LR
    G1[HallScene] --> G2[NavGrid A*]
    G1 --> G3[NetSync]
  end
  subgraph STATE[Global state]
    direction LR
    S1[(hallStore · Zustand<br/>me · nearby · current booth · mic)]
    S2[(TanStack Query<br/>REST cache)]
  end
  subgraph LIB[lib/ · shared logic]
    direction LR
    L1[apiClient<br/>fetch + Problem error]
    L2[realtimeClient<br/>Colyseus]
    L3[ProximityMedia<br/>LiveKit]
    L4[geometry<br/>zones · distance]
  end
  subgraph UI[components/ui · design system]
    direction LR
    U1[Button · Card · Dialog · Input · Tabs] ~~~ U2[Avatar · Actor · StatusBadge · Chip]
  end
  PKG[[packages/shared · DTO + message types]]
  PAGES --> FEAT
  FEAT --> GAME
  FEAT <--> STATE
  GAME -- events --> STATE
  FEAT --> LIB
  GAME --> LIB
  FEAT --> UI
  LIB --> PKG
