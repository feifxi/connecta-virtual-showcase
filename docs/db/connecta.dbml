// Connecta — physical schema (PostgreSQL) · source of truth for columns = docs/data-model.md
// view/edit: paste into https://dbdiagram.io · render PNG: node docs/db/render.mjs

Project connecta {
  database_type: 'PostgreSQL'
}

// ---------- enums ----------
Enum app_role {
  USER
  PLATFORM_ADMIN
}
Enum event_role {
  ADMIN
  PRESENTER
  JUDGE
}
Enum event_status {
  DRAFT
  PUBLISHED
  LIVE
  EXHIBITION
  ARCHIVED
}
Enum hall_open_mode {
  SCHEDULE
  MANUAL
}
Enum plan {
  FREE
  PRO
}
Enum visitor_type {
  STUDENT
  HIGH_SCHOOL
  COMPANY
  ALUMNI
  PARENT
  TEACHER
}
Enum invite_status {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}
Enum hall_source {
  PRESET
  CUSTOM
}
Enum file_kind {
  POSTER
  SLIDES
  DOC
  MODEL_3D
}
Enum form_kind {
  JOIN
  SURVEY
}
Enum feedback_status {
  VISIBLE
  HIDDEN
  REMOVED
}
Enum sheet_status {
  DRAFT
  SUBMITTED
}
Enum award_kind {
  JUDGES
  AUDIENCE
}
Enum report_target {
  USER
  CHAT
  FEEDBACK
}
Enum report_status {
  OPEN
  RESOLVED
  DISMISSED
}

// ---------- 1. account ----------
Table users {
  id uuid [pk]
  email text [unique, not null]
  email_verified bool
  name text
  display_name text
  avatar_preset text
  visitor_type visitor_type
  province text
  organization text [null]
  position text [null]
  app_role app_role [default: 'USER']
  onboarded_at timestamptz [null]
  deleted_at timestamptz [null]
  created_at timestamptz
  updated_at timestamptz
}

Table sessions {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  token text [unique]
  expires_at timestamptz
  ip_address text
  user_agent text
}

Table accounts {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  provider_id text
  account_id text
  access_token text
  refresh_token text
  indexes { (provider_id, account_id) [unique] }
}

Table verifications {
  id uuid [pk]
  identifier text
  value text
  expires_at timestamptz
}

Table jwks {
  id uuid [pk]
  public_key text
  private_key text
  created_at timestamptz
}

Table user_emails {
  user_id uuid [ref: > users.id]
  email text [pk]
  verified_at timestamptz
}

Table notifications {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  kind text
  payload jsonb
  read_at timestamptz [null]
  created_at timestamptz
  indexes { (user_id, read_at) }
}

Table subscriptions {
  user_id uuid [pk, ref: - users.id]
  plan plan
  status text
  current_period_end timestamptz
  stripe_customer_id text [null]
  stripe_subscription_id text [null]
}

// ---------- 2. event & people ----------
Table events {
  id uuid [pk]
  created_by uuid [ref: > users.id]
  slug text [unique]
  title text
  description text
  cover_key text [null]
  agenda jsonb
  modules jsonb
  status event_status
  plan plan
  capacity int
  starts_at timestamptz
  ends_at timestamptz [note: 'CHECK ends_at > starts_at']
  hall_open_mode hall_open_mode
  exhibition_until timestamptz [null]
  results_announced_at timestamptz [null]
  allowed_domain text [null]
  booth_deadline timestamptz [null]
  hall_preset text
  suspended_at timestamptz [null]
  created_at timestamptz
  updated_at timestamptz
  indexes { (status, starts_at) }
}

Table event_categories {
  id uuid [pk]
  event_id uuid [ref: > events.id]
  name text
  color text
  sort int
  indexes { (event_id, name) [unique] }
}

Table event_members {
  event_id uuid [pk, ref: > events.id]
  user_id uuid [pk, ref: > users.id]
  roles "event_role[]"
  assigned_by uuid [ref: > users.id]
  assigned_at timestamptz
}

Table event_invites {
  id uuid [pk]
  event_id uuid [ref: > events.id]
  email text
  roles "event_role[]"
  project_id uuid [null, ref: > projects.id]
  token_hash text [unique]
  status invite_status
  invited_by uuid [ref: > users.id]
  accepted_by uuid [null, ref: > users.id]
  expires_at timestamptz
  created_at timestamptz
  accepted_at timestamptz [null]
  indexes { (event_id, status) }
}

Table event_addons {
  id uuid [pk]
  event_id uuid [ref: > events.id]
  bought_by uuid [ref: > users.id]
  extra_capacity int
  extra_exhibition_days int
  stripe_payment_id text [null]
  created_at timestamptz
}

Table event_bans {
  event_id uuid [pk, ref: > events.id]
  user_id uuid [pk, ref: > users.id]
  banned_by uuid [ref: > users.id]
  reason text
  created_at timestamptz
}

// ---------- 3. hall · project · file ----------
Table halls {
  id uuid [pk]
  event_id uuid [unique, ref: - events.id]
  source hall_source
  map_json jsonb
}

Table booth_slots {
  id uuid [pk]
  hall_id uuid [ref: > halls.id]
  block text
  fill_order int
  x int
  y int
  w int
  h int
  label text
  indexes { (hall_id, fill_order) [unique] }
}

Table projects {
  id uuid [pk]
  event_id uuid [ref: > events.id]
  category_id uuid [null, ref: > event_categories.id]
  booth_slot_id uuid [null, unique, ref: - booth_slots.id]
  title text
  summary text [null]
  tags "text[]"
  cover_key text [null]
  video_url text [null]
  links jsonb
  ai_enabled bool
  created_at timestamptz
  updated_at timestamptz
  indexes { (event_id, category_id) }
}

Table project_members {
  project_id uuid [pk, ref: > projects.id]
  user_id uuid [pk, ref: > users.id]
}

Table project_files {
  id uuid [pk]
  project_id uuid [ref: > projects.id]
  kind file_kind
  object_key text
  mime text
  size_bytes bigint
  page_count int [null]
  use_for_ai bool
  uploaded_by uuid [ref: > users.id]
  created_at timestamptz
}

Table doc_chunks {
  id bigserial [pk]
  project_id uuid [ref: > projects.id]
  file_id uuid [ref: > project_files.id]
  content text
  embedding vector
}

// ---------- 4. joining · in the event ----------
Table event_interests {
  event_id uuid [pk, ref: > events.id]
  user_id uuid [pk, ref: > users.id]
  created_at timestamptz
}

Table event_attendees {
  event_id uuid [pk, ref: > events.id]
  user_id uuid [pk, ref: > users.id]
  display_name text
  visitor_type visitor_type
  province text
  consent_marketing bool
  joined_at timestamptz
}

Table event_forms {
  id uuid [pk]
  event_id uuid [ref: > events.id]
  kind form_kind
  fields jsonb
  indexes { (event_id, kind) [unique] }
}

Table form_responses {
  form_id uuid [pk, ref: > event_forms.id]
  user_id uuid [pk, ref: > users.id]
  answers jsonb
  created_at timestamptz
}

Table feedbacks {
  id uuid [pk]
  project_id uuid [ref: > projects.id]
  author_id uuid [ref: > users.id]
  text text
  is_anonymous bool
  status feedback_status
  created_at timestamptz
}

Table votes {
  event_id uuid [pk, ref: > events.id]
  user_id uuid [pk, ref: > users.id]
  project_id uuid [pk, ref: > projects.id]
  created_at timestamptz
}

Table contact_requests {
  id uuid [pk]
  project_id uuid [ref: > projects.id]
  user_id uuid [ref: > users.id]
  email text
  phone text [null]
  link text [null]
  message text [null]
  created_at timestamptz
  indexes { (project_id, user_id) [unique] }
}

Table reports {
  id uuid [pk]
  event_id uuid [ref: > events.id]
  reporter_id uuid [ref: > users.id]
  target_user_id uuid [ref: > users.id]
  target_kind report_target
  target_ref text [null]
  snapshot text [null]
  reason text
  status report_status
  handled_by uuid [null, ref: > users.id]
  created_at timestamptz
}

// ---------- 5. judging ----------
Table rubrics {
  id uuid [pk]
  event_id uuid [unique, ref: - events.id]
  locked_at timestamptz [null]
}

Table rubric_criteria {
  id uuid [pk]
  rubric_id uuid [ref: > rubrics.id]
  name text
  description text
  max_score int [note: 'CHECK > 0']
  weight "numeric(5,2)" [note: 'CHECK > 0']
  sort int
}

Table judge_assignments {
  event_id uuid [ref: > events.id]
  judge_id uuid [pk, ref: > users.id]
  project_id uuid [pk, ref: > projects.id]
}

Table score_sheets {
  id uuid [pk]
  judge_id uuid [ref: > users.id]
  project_id uuid [ref: > projects.id]
  status sheet_status
  comment text [null]
  comment_visible bool
  submitted_at timestamptz [null]
  updated_at timestamptz
  indexes { (judge_id, project_id) [unique] }
}

Table scores {
  sheet_id uuid [pk, ref: > score_sheets.id]
  criterion_id uuid [pk, ref: > rubric_criteria.id]
  score numeric
}

Table awards {
  event_id uuid [pk, ref: > events.id]
  kind award_kind [pk]
  rank int [pk]
  project_id uuid [ref: > projects.id]
}

// ---------- 6. analytics · log ----------
Table presence_sessions {
  id bigserial [pk]
  event_id uuid [ref: > events.id]
  user_id uuid [ref: > users.id]
  joined_at timestamptz
  left_at timestamptz [null]
}

Table booth_visits {
  id bigserial [pk]
  event_id uuid [ref: > events.id]
  project_id uuid [ref: > projects.id]
  user_id uuid [ref: > users.id]
  entered_at timestamptz
  left_at timestamptz [null]
  indexes { (project_id, user_id) }
}

Table heatmap_counts {
  event_id uuid [pk, ref: > events.id]
  cell_x int [pk]
  cell_y int [pk]
  minute timestamptz [pk]
  samples int
}

Table analytics_events {
  id bigserial [pk]
  event_id uuid [ref: > events.id]
  user_id uuid [null, ref: > users.id]
  type text
  project_id uuid [null, ref: > projects.id]
  data jsonb
  created_at timestamptz
  indexes { (event_id, type, created_at) }
}

Table audit_logs {
  id bigserial [pk]
  event_id uuid [null, ref: > events.id]
  actor_id uuid [ref: > users.id]
  action text
  target_id uuid [null]
  reason text [null]
  data jsonb
  created_at timestamptz
  indexes { (event_id, created_at) }
}

// ---------- groups (one diagram each) ----------
TableGroup account {
  users
  sessions
  accounts
  verifications
  jwks
  user_emails
  notifications
  subscriptions
}
TableGroup event_people {
  events
  event_categories
  event_members
  event_invites
  event_addons
  event_bans
}
TableGroup hall_project {
  halls
  booth_slots
  projects
  project_members
  project_files
  doc_chunks
}
TableGroup in_event {
  event_interests
  event_attendees
  event_forms
  form_responses
  feedbacks
  votes
  contact_requests
  reports
}
TableGroup judging {
  rubrics
  rubric_criteria
  judge_assignments
  score_sheets
  scores
  awards
}
TableGroup analytics {
  presence_sessions
  booth_visits
  heatmap_counts
  analytics_events
  audit_logs
}
